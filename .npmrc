# Expo's Metro bundler resolves transitive dependencies by walking node_modules, which
# pnpm's default isolated (symlinked) layout deliberately hides. Without hoisting, the
# expo-router entry point cannot resolve @expo/metro-runtime, which in turn cannot
# resolve @expo/log-box, and so on — a whack-a-mole of adding transitive packages as
# direct dependencies purely to satisfy the bundler.
#
# A hoisted linker is the configuration Expo documents for pnpm monorepos and fixes the
# entire class in one place. The cost is pnpm's strictness about undeclared imports,
# which is a tradeoff worth taking to keep the dependency list honest.
node-linker=hoisted
