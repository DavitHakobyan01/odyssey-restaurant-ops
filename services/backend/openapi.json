  "paths": {
    "/menu/categories": {
      "get": {
        "tags": [
          "Menu"
        ],
        "summary": "List menu categories",
        "operationId": "listMenuCategories",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "default": false,
              "description": "Include categories that are hidden from the live menu."
            },
            "required": false,
            "description": "Include categories that are hidden from the live menu.",
            "name": "includeInactive",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Categories in display order.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MenuCategory"
                  }
                }
              }
