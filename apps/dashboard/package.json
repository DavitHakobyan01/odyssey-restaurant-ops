{
  "name": "@odyssey/dashboard",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --web --port 8081",
    "dev:native": "expo start",
    "build": "expo export --platform web",
    "lint": "eslint app src --ext .ts,.tsx --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf .turbo .expo dist node_modules"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.9",
    "@odyssey/api-client": "workspace:*",
    "@odyssey/shared": "workspace:*",
    "@odyssey/types": "workspace:*",
    "@odyssey/ui": "workspace:*",
    "@tanstack/react-query": "^5.64.1",
    "expo": "~57.0.12",
    "expo-constants": "~57.0.10",
    "expo-font": "~57.0.1",
    "expo-linking": "~57.0.5",
    "expo-router": "~57.0.12",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "~15.14.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@odyssey/eslint-config": "workspace:*",
    "@react-native/metro-config": "0.86.2",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "~19.2.2",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
    "eslint": "^9.18.0"
  }
}
