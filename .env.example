# Copy to .env at the repo root:  cp .env.example .env
#
# Matches docker-compose.yml exactly, so `docker compose up -d` needs no edits here.
# Any Postgres works — a Neon pooled connection string drops in unchanged, because the
# Worker talks to Postgres over TCP via postgres-js + nodejs_compat rather than a
# vendor-specific HTTP driver.
DATABASE_URL=postgresql://odyssey:odyssey@localhost:5432/restaurant

# Where the dashboard looks for the backend. Must be EXPO_PUBLIC_ prefixed to be
# inlined into the client bundle by Expo.
EXPO_PUBLIC_API_URL=http://localhost:8787
